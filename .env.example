# Base directory for the project
BASE_DIR="path/to/the/base/directory"

# Data and results directories (can be set to different locations)
DATA_DIR="path/to/the/data"
RESULTS_DIR="path/to/the/results"
LOGS_DIR="path/to/the/logs"

LAB_DATA_DIR="path/to/the/lab/raw/data"
SEQUENCHER_DIR="path/to/the/sequencher"

# PC (Positive Control) configuration
PC_DATA_DIR="path/to/the/PC/data"
PC_RESULTS_DIR="path/to/the/PC/results"

# Reference genome path
REFERENCE="/ref/rCRS.fasta"

# Tracy executable path
MTDNA_TOOLS_TRACY="/tools/tracy"

# Cores one pipeline run may use, split between its concurrent batches (-j).
# Without this each tool takes os.cpu_count(), so a single run saturates the
# machine and leaves nothing for anyone else. Defaults to 128.
MTDNA_MAX_CORES=128

# Threshold for variant calling
THRESHOLD=0.01

# Default test date and time (used for report generation)
TIME="09:00"

# Authentication token for report generation
AUTH_TOKEN=""

# Google Sheets — one sheet per task, so a rerun or a training run can never
# overwrite the production worksheet. The web UI lists these by name; on the
# command line pass --sheet-id. Leave a line empty to hide that sheet from the UI.
CREDENTIALS_FILE="credentials/google_sheets_credentials.json"
GOOGLE_SHEET_ID=""            # standard batches
GOOGLE_SHEET_ID_TRAINING=""   # training batches
GOOGLE_SHEET_ID_RERUN=""      # rerun batches
